{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PocketArk",
  "version": "0.1.0",
  "identifier": "com.hmilyld.pocketark",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PocketArk",
        "width": 1080,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 10, "y": 14 },
        "hiddenTitle": true,
        "backgroundColor": "#16161c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["local-resources/**/*"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMjg2RkQ2OTM0NDlFMTEKUldRUm5rU1QxbThvSG5PQzlpZUFXbEFFYmZacWoyYlMrejM5aHhIdmYyWkNBOTdNOU5FU2lWcCsK",
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["pocketark"]
      }
    }
  }
}
